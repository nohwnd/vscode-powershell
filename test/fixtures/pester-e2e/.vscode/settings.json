{
  // Deliberately does NOT turn the Test Explorer off. Pressing F5 opens this
  // folder, so the feature has to be live here or there is nothing to look at.
  // The end-to-end tests build a second controller alongside the extension's
  // and only observe their own, which is why the diagnostic command
  // registration tolerates the id already being taken.
  "powershell.pester.testFilePath": ["**/*.[tT]ests.[pP][sS]1"],
  "powershell.promptToUpdatePowerShell": false,
  "powershell.integratedConsole.showOnStartup": false
}
